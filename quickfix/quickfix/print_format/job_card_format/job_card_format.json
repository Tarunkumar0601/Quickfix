 "font_size": 14,
 "html": "<style>\n    @page {\n        size: A4;\n        margin: 1cm;\n    }\n    \n    @media print {\n        .no-print,\n        button,\n        a,\n        .btn,\n        ,print-hide {\n            display: none !important;\n        }\n    }\n\n    .header {\n        text-align: center;\n        font-size: 22px;\n        font-weight: bold;\n    }\n\n    .section {\n        margin-top: 15px;\n    }\n\n    .urgent {\n        color: red;\n        font-weight: bold;\n        font-size: 18px;\n        text-align: center;\n        border: 2px dashed red;\n        padding: 5px;\n    }\n\n    .total {\n        font-size: 20px;\n        font-weight: bold;\n        margin-top: 15px;\n    }\n    \n    .page-break {\n        page-break-before: always;\n    }\n    \n    .qf-header {\n        display: flex;\n        justify-content: space-between;\n        border-bottom: 2px solid #333;\n        padding-bottom: 6px;\n        margin-bottom: 10px;\n    }\n    \n    .qf-header-left h2 {\n        margin: 0;\n        color: #2c3e50;\n    }\n    \n    .qf-sub {\n        font-size: 11px;\n        color: #555;\n    }\n    \n    .qf-heder-right {\n        text-align: right;\n        font-size: 12px;\n    }\n    \n    .qf-footer {\n        position: fixed;\n        bottom: 0;\n        left: 0;\n        right: 0;\n        border-top: 1px solid #999;\n        padding-top: 5px;\n        font-size: 10px;\n        color: #666;\n        display: flex;\n        justify-content: space-between;\n    }\n    \n    body {\n        padding-bottom: 30px;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    table, th, td {\n        border: 1px solid #000;\n        padding: 6px;\n    }\n</style>\n\n{{ letter_head }}\n\n\n{% if doc.priority == \"Urgent\" %}\n<div class=\"urgent\">\n    \u26a0 {{ _(\"URGENT JOB\") }} \u26a0\n</div>\n{% endif %}\n\n<div class=\"section\">\n    <b>{{ _(\"Customer Details\") }}</b><br>\n    {{ _(\"Name\") }}: {{ doc.customer_name }}<br>\n    {{ _(\"Phone\") }}: {{ doc.customer_phone }}<br>\n</div>\n\n<div class=\"section\">\n    <b>{{ _(\"Device Details\") }}</b><br>\n    {{ _(\"Type\") }}: {{ doc.device_type }}<br>\n    {{ _(\"Brand\") }}: {{ doc.device_brand }}<br>\n    {{ _(\"Model\") }}: {{ doc.device_model }}<br>\n</div>\n\n{%if doc.parts_used and doc.parts_used | length > 10 %}\n<div class=\"page-break\"></div>\n{% endif %}\n\n<div class=\"section\">\n    <b>{{ _(\"Parts Used\") }}</b>\n    <table>\n        <thead>\n            <tr>\n                <th>{{ _(\"Part\") }}</th>\n                <th>{{ _(\"Quantity\") }}</th>\n                <th>{{ _(\"Unit Price\") }}</th>\n                <th>{{ _(\"Total\") }}</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for p in doc.parts_used %}\n            <tr>\n                <td>{{ p.part }}</td>\n                <td>{{ p.quantity }}</td>\n                <td>{{ frappe.format_value(p.unit_price, {\"fieldtype\": \"Currency\"}) }}</td>\n                <td>{{ frappe.format_value(p.total_price, {\"fieldtype\": \"Currency\"}) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>\n\n<div class=\"section\">\n    {{ _(\"Labour Charge\") }}: {{ frappe.format_value(doc.labour_charge, {\"fieldtype\": \"Currency\"}) }}\n</div>\n\n<div class=\"total\">\n    {{ _(\"Final Amount\") }}: {{ frappe.format_value(doc.final_amount, {\"fieldtype\": \"Currency\"}) }}\n</div>\n\n<hr>\n\n{% set job_url = frappe.utils.get_url() + \"/app/job-card/\" + doc.name %}\n\n{% set qr_base64 = frappe.call(\"quickfix.utils.get_qr_base64\", data=job_url) %}\n\n<div style=\"text-align:right; margin-top:10px;\">\n    <img src=\"data:image/png;base64,{{ qr_base64 }}\" \n         style=\"width:120px; height:120px;\" />\n    <div style=\"font-size:10px; margin-top:5px;\">\n        Scan to view Job Card\n    </div>\n</div>\n\n<div>\n    {{ _(\"Summary\") }}: {{ doc.print_summary }}\n</div>\n\n{{ footer }}",
